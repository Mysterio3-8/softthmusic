[Unit]
Description=Тик альбомного конвейера SoundCloud -> VK

[Timer]
# Момент публикации хранится в БД (next_post_at, случайный интервал 3-5 ч),
# таймер лишь спрашивает «пора?» — поэтому рандом переживает рестарт сервера.
#
# Шаг 3 минуты, а не 15: публикация идёт сразу, без отложки, значит минута
# записи = минута тика. При шаге 15 мин все посты падали бы на одни и те же
# 4 значения минут — ровно тот роботизированный тайминг, от которого уходим.
OnBootSec=2min
OnUnitActiveSec=3min
# Пропущенные из-за выключенного сервера тики не копятся пачкой.
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target
