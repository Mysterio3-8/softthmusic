[Unit]
Description=Тик конвейера сборников YouTube -> VK

[Timer]
# Момент следующего сборника считается от времени ПРОШЛОЙ публикации (post_log),
# а не расписанием systemd — поэтому случайный интервал переживает рестарт сервера.
# Таймер лишь спрашивает «пора?».
#
# Шаг 15 минут, а не 3 как у альбомного тика: сборник — тяжёлая работа (скачивание
# плейлиста + рендер каждого трека), а публикаций всего две в сутки. Частый опрос
# ничего не ускорит, зато каждый холостой тик поднимает python и дёргает пул токенов.
OnBootSec=10min
OnUnitActiveSec=15min
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target
