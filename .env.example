# --- Групповой токен сообщества (постинг wall.post) ---
# Scope: wall, groups. Им создаются отложенные записи. Банобезопасен для частого
# постинга в свою группу.
VK_GROUP_TOKEN=

# --- User-токен (ТОЛЬКО загрузка видео) ---
# Нужен потому, что VK не даёт грузить видео групповым токеном (ошибка [5]).
# Токен пользователя-администратора сообщества, scope: video.
# Используется 1 раз на ролик (3/день) — минимальная нагрузка, чтобы не словить бан.
# Получить: https://vkhost.github.io/ (выбрать права video).
VK_USER_TOKEN=

# --- Telegram (уведомления о готовности альбома) ---
# Токен бота, через который приходят уведомления. Здесь используется ТОЛЬКО
# sendMessage — поллинга нет, поэтому токен можно взять тот же, что у бота
# Новостей: конфликт getUpdates бывает при двойном поллинге, а не при отправке.
TELEGRAM_BOT_TOKEN=

# Запасной адресат уведомлений, если альбом поставлен в очередь не из бота
# (например, руками из консоли). Свой id: @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=
